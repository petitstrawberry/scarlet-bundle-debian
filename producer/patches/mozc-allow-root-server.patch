Description: Allow only the Linux conversion server to run as root on Scarlet
 Scarlet's Linux ABI currently reports UID/EUID 0. Keep the normal client and
 renderer checks; SWS and scarlet-mozc provide the native user interface.
Forwarded: not-needed
--- a/src/base/run_level.cc
+++ b/src/base/run_level.cc
@@ -249,6 +249,13 @@
   // WASM doesn't have runlevels. Always return normal.
   return RunLevel::NORMAL;
 #else  // _WIN32
+#if defined(__linux__)
+  // Scarlet Linux ABI runs mozc_server as uid 0 for now.
+  // This exception is limited to the conversion server.
+  if (type == SERVER) {
+    return RunLevel::NORMAL;
+  }
+#endif
   if (type == SERVER || type == RENDERER) {
     if (::geteuid() == 0) {
       // This process is started by root, or the executable is setuid to root.

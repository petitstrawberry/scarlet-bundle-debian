#!/bin/sh
# Explicit Box64 entry point; no kernel binfmt_misc registration is required.
export WINELOADER=/usr/lib/wine/wine64
export WINESERVER=/usr/local/bin/wineserver
export WINEARCH=win64
export BOX64_LD_LIBRARY_PATH="/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu${BOX64_LD_LIBRARY_PATH:+:$BOX64_LD_LIBRARY_PATH}"
# Debian's FFmpeg dependency calls BIO callback getters not implemented by
# Box64 v0.4.4's OpenSSL wrapper. Keep that ABI entirely in the amd64 libraries.
export BOX64_EMULATED_LIBS="libssl.so.3:libcrypto.so.3${BOX64_EMULATED_LIBS:+:$BOX64_EMULATED_LIBS}"
exec /usr/local/bin/box64 /usr/lib/wine/wine64 "$@"
